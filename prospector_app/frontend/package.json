    "test:e2e": "pnpm run build && node --test --test-concurrency=1 e2e/*.test.ts"
  },
  "dependencies": {
    "html2canvas-pro": "^2.4.3",
    "react": "^19.3.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vibium": "26.8.21",
    "vite": "^8.3.0"
  }
