#!/usr/bin/env python3
"""The app agent's read window into GitHub's raw contents + code search.

The agent's allowlisted `gh` commands (chat.py:_GH_ALLOW) cover PR/issue/search
subcommands but not `gh api`, because `gh api` is read-only only by *default* —
`gh api -X PUT repos/<repo>/contents/<path> -f content=…` writes a file to the
default branch and `gh api -X PUT .../pulls/N/merge` merges a PR, both bypassing
the executor's gate. A prefix allowlist can't forbid a trailing `-X PUT`, so raw
`gh api` can't be allowlisted safely. This command is the safe read-only slice:
it shells out to `gh api` with the method hardcoded to GET and the endpoint built
from fixed strings, so there is no way to turn it into a write.

Two things the agent can't otherwise see — a file's exact bytes at a ref, and a
tree-wide code search — both plain GETs against the upstream repo (settings.REPO):

Usage:
    prospector_app/agent/gh-read file <path>            # raw file at the default branch
    prospector_app/agent/gh-read file <path> --ref <r>  # …at a branch/tag/SHA
    prospector_app/agent/gh-read search '<query>'       # code search, scoped to the repo

`file` prints the raw bytes (`gh` exits non-zero with a 404 on stderr if the path
doesn't exist, so the agent can report "no such file" instead of inventing one).
`search` prints GitHub's JSON result; the repo qualifier is appended automatically
unless the query already carries a `repo:` one. Reads only — no bot token, no
upstream write — so it rides the same always-available allowlisted-Bash path as
`store-read`; it runs under the app's uv env, where every agent command runs.
NOTE: keep the allowlist prefix in chat.py (_GH_READ_ALLOW) in sync with this path.
"""
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
# Run under a bare python3 (the agent's shell): put the repo root on the path for
# the `pipeline` package rather than relying on the editable install.
sys.path.insert(0, str(REPO_ROOT))

from pipeline import settings  # noqa: E402


def _run(argv: list[str]) -> int:
    """Run a fixed `gh` argv, streaming its stdout/stderr straight through so the
    agent sees the raw file / JSON (and any GitHub error). Never a shell string —
    argv elements are passed as-is, so a path or query can't inject extra flags."""
    return subprocess.run(argv, check=False).returncode


def read_file(path: str, ref: str | None) -> int:
    # Method is fixed (a GET; no -X), so this can only read. A leading slash would
    # make an absolute API path — strip it so the endpoint stays repo-scoped.
    endpoint = f"repos/{settings.REPO}/contents/{path.lstrip('/')}"
    if ref:
        endpoint += f"?ref={ref}"
    return _run(["gh", "api", endpoint, "-H", "Accept: application/vnd.github.raw"])


def search_code(query: str) -> int:
    # Scope the search to the upstream repo unless the caller already qualified it.
    q = query if "repo:" in query else f"{query} repo:{settings.REPO}"
    return _run(["gh", "api", "-X", "GET", "search/code", "-f", f"q={q}"])


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="gh-read",
        description="Read a raw file or run a code search against the upstream repo (GET-only).",
    )
    sub = p.add_subparsers(dest="what", required=True)

    f = sub.add_parser("file", help="print a file's raw bytes at a ref")
    f.add_argument("path", help="repo-relative path, e.g. .gitattributes")
    f.add_argument("--ref", default=None, help="branch/tag/SHA (default: the default branch)")

    s = sub.add_parser("search", help="search code in the repo")
    s.add_argument("query", help="GitHub code-search query")

    args = p.parse_args(argv)
    if args.what == "file":
        return read_file(args.path, args.ref)
    return search_code(args.query)


if __name__ == "__main__":
    raise SystemExit(main())
