#!/usr/bin/env python3
"""The app agent's "file a ticket on the meta-repo" path — AS THE OPERATOR.

The meta-repo (`PROSPECTOR_FEEDBACK_REPO`) is where triager/pipeline bugs and
enhancement requests go. It is outside the bot's GitHub App installation, so the
bot token cannot even resolve it — a plain `gh issue create --repo <meta>` fails
with "Could not resolve to a Repository" whenever the chat-agent subprocess is
authenticated as the bot. This script is the sanctioned path: it drops the bot
token and files with `PROSPECTOR_FEEDBACK_TOKEN`, the operator's own credential
for the meta-repo, or with `gh`'s stored login when none is set. A fine-grained
token has one resource owner, so the login `gh` holds for the triaged repo's
organization cannot file on a meta-repo another organization owns. The chat
agent's environment withholds the token; this script reads it from the
repo-root .env, which `pipeline.settings` loads on import.

The repo is fixed to the configured meta-repo — the operator-identity write is
scoped to filing a ticket on their own tooling repo, and nothing else. Filing
upstream stays on the bot's path (`gh issue create --repo <upstream>`).

Usage:
    file-issue --title "<title>" --body "<body>" [--label bug]
    file-issue --title "<title>" --body-file <path> [--label bug ...]

Stdlib only, so it runs under the sandbox's system python (like `remember` /
`resubmit`).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
# Run under a bare python3 (the agent's shell): put the repo root on the path for
# the `pipeline` package rather than relying on the editable install.
sys.path.insert(0, str(REPO_ROOT))

from pipeline import settings  # noqa: E402


def operator_env(token: str | None) -> dict[str, str]:
    """Env that authenticates `gh` as the OPERATOR, not the bot: drop the injected
    bot GH_TOKEN (and GITHUB_TOKEN), then set GH_TOKEN to `token` when there is
    one, else leave `gh` its stored login. Everything else (PATH, HOME) is
    inherited so the operator's credentials resolve."""
    env = dict(os.environ)
    env.pop("GH_TOKEN", None)
    env.pop("GITHUB_TOKEN", None)
    env.pop("PROSPECTOR_FEEDBACK_TOKEN", None)
    if token:
        env["GH_TOKEN"] = token
    return env


def refusal_hint(repo: str, token: str | None) -> str:
    """What the credential `gh` filed with needs, naming it but never its value."""
    if token:
        who = "PROSPECTOR_FEEDBACK_TOKEN"
    else:
        who = ("gh's stored login (PROSPECTOR_FEEDBACK_TOKEN is unset; set it in "
               ".env to file with a token of its own)")
    hint = f"file-issue: filing on {repo} as {who} needs Issues: Read and write on {repo}"
    if token is None or token.startswith("github_pat_"):
        owner = repo.split("/", 1)[0]
        hint += f"; a fine-grained token also needs {owner} as its resource owner"
    return hint + "."


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="file-issue",
        description="File an issue on the configured meta-repo as the operator.",
    )
    p.add_argument("--title", required=True, help="the issue title")
    body = p.add_mutually_exclusive_group(required=True)
    body.add_argument("--body", help="the issue body, inline")
    body.add_argument("--body-file", dest="body_file", help="path to a file holding the body")
    p.add_argument("--label", action="append", default=[], metavar="LABEL",
                   help="a label to apply (repeatable)")
    args = p.parse_args(argv)

    if not settings.feedback_repo():
        print("file-issue: no meta-repo configured (PROSPECTOR_FEEDBACK_REPO is unset)",
              file=sys.stderr)
        return 2

    cmd = ["gh", "issue", "create", "--repo", settings.feedback_repo(), "--title", args.title]
    if args.body_file:
        path = Path(args.body_file)
        if not path.is_file():
            print(f"file-issue: body file not found: {path}", file=sys.stderr)
            return 2
        cmd += ["--body-file", str(path)]
    else:
        cmd += ["--body", args.body]
    for label in args.label:
        cmd += ["--label", label]

    token = settings.feedback_token()
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60,
                       env=operator_env(token))
    if r.returncode != 0:
        print(f"file-issue: {r.stderr.strip() or r.stdout.strip()}", file=sys.stderr)
        print(refusal_hint(settings.feedback_repo(), token), file=sys.stderr)
        return 1
    # A receipt requires gh's canonical URL for the configured repository.
    url = r.stdout.strip()
    match = re.fullmatch(
        rf"https://github\.com/{re.escape(settings.feedback_repo())}/issues/(\d+)/?", url
    )
    if match is None:
        print(f"file-issue: unexpected success output from gh: {url!r}", file=sys.stderr)
        return 1
    print(json.dumps({
        "ok": True,
        "kind": "feedback-issue",
        "repo": settings.feedback_repo(),
        "number": int(match.group(1)),
        "url": url.rstrip("/"),
    }, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
