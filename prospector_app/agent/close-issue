#!/usr/bin/env python3
"""Close one upstream issue through the app executor and activity log.

The helper mints a configured bot token for its confirmed close and turns the
request into the same ``IssueCloseBody`` operation the Issues UI uses, so the
live gate, bot identity, issue-store reflection, and append-only Activity entry
all come from one executor path.

Usage:
    close-issue <issue> --disposition not-planned --comment "<why>"
    close-issue <issue> --disposition completed --comment "<what completed>"
    close-issue <issue> --disposition fixed --fixed-by <pr> [--comment "<why>"]
    close-issue <issue> --disposition dup --canonical <issue> [--comment "<why>"]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO_ROOT))

from prospector_app.backend import executor  # noqa: E402
from prospector_app.backend import models  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="close-issue",
        description="Close an issue as the configured bot and record it in Activity.",
    )
    p.add_argument("issue", type=int, help="the issue number to close")
    p.add_argument(
        "--disposition",
        required=True,
        choices=("not-planned", "completed", "fixed", "dup"),
        help="the close semantics and GitHub state reason",
    )
    p.add_argument("--comment", help="the closing comment")
    p.add_argument("--fixed-by", type=int, help="merged PR that fixed the issue")
    p.add_argument("--canonical", type=int, help="canonical issue for a duplicate")
    args = p.parse_args(argv)

    token = executor.mint_bot_token()
    if not token:
        detail = executor.mint_error() or "bot token mint returned no token"
        print(f"close-issue: bot installation token unavailable: {detail}", file=sys.stderr)
        return 2

    action = models.IssueCloseBody(
        disposition=args.disposition,
        comment=args.comment,
        fixed_by=args.fixed_by,
        canonical=args.canonical,
    )
    result = executor.close_issue_with_comment(
        args.issue, action, token=token, dry_run=False,
    )
    print(json.dumps(result, sort_keys=True))
    return 0 if result.get("status") == "executed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
