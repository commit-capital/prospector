#!/usr/bin/env python3
"""Reopen one upstream PR through the app executor and Activity log."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO_ROOT))

from pipeline import bot_token  # noqa: E402
from prospector_app.backend import executor  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="reopen-pr",
        description="Reopen a PR as the configured bot and record it in Activity.",
    )
    p.add_argument("pr", type=int, help="the pull request number to reopen")
    args = p.parse_args(argv)

    if not bot_token.available():
        detail = bot_token.last_error() or "bot token mint returned no token"
        print(f"reopen-pr: bot installation token unavailable: {detail}", file=sys.stderr)
        return 2

    result = executor.reopen_pr(args.pr, dry_run=False)
    print(json.dumps(result, sort_keys=True))
    return 0 if result.get("status") == "reopened" else 1


if __name__ == "__main__":
    raise SystemExit(main())
