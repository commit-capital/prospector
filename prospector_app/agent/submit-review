#!/usr/bin/env python3
"""Submit one upstream PR review through the app executor and Activity log."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO_ROOT))

from prospector_app.backend import executor  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="submit-review",
        description="Review a PR as the configured bot and record it in Activity.",
    )
    p.add_argument("pr", type=int, help="the pull request number to review")
    p.add_argument(
        "--event",
        required=True,
        choices=("approve", "request-changes", "comment"),
        help="the GitHub review event to submit",
    )
    p.add_argument("--body", default="", help="the review body")
    args = p.parse_args(argv)

    token = executor.mint_bot_token()
    if not token:
        detail = executor.mint_error() or "bot token mint returned no token"
        print(f"submit-review: bot installation token unavailable: {detail}", file=sys.stderr)
        return 2

    result = executor.submit_review(
        args.pr, args.event, args.body, token=token, dry_run=False,
    )
    print(json.dumps(result, sort_keys=True))
    return 0 if result.get("status") == "executed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
