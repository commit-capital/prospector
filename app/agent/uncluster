#!/usr/bin/env python3
"""The cockpit agent's manual clustering override.

Clustering is automated (the CLUSTER phase), but it occasionally mis-groups a
PR — most often when a PR's head moved to unrelated content after it was
clustered, so it stays glued to a cluster whose root problem its current diff no
longer addresses. This allowlisted command lets the agent detach such a PR on the
operator's say-so, without a full re-cluster pass.

It removes a PR from one cluster (--from) or from every cluster it belongs to
(--all), through the validated store accessor (model.Cluster.remove_member) — the
ONLY sanctioned way to mutate membership. Detaching a PR from its last cluster
leaves a current standalone stamp (a confirmed singleton), exactly as a clustering
pass would. The cluster keeps its other members; a cluster emptied to one member
is allowed (a single-PR cluster is a valid end state).

Usage:
    app/agent/uncluster <pr> --from <cluster_id>
    app/agent/uncluster <pr> --all

Stdlib only, so it runs under the sandbox's system python (like `remember`). It
reuses pipeline/store.py for the single source of truth on the store shape.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
# Run under a bare python3 (the agent's shell), so put the repo root on the path
# for the `pipeline` package rather than relying on the editable install.
sys.path.insert(0, str(REPO_ROOT))

from pipeline import storekit  # noqa: E402
from pipeline.store import Store  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="uncluster",
        description="Detach a PR from a mis-grouped cluster (manual clustering override).",
    )
    p.add_argument("pr", type=int, help="the PR number to detach")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--from", dest="cluster", type=int, metavar="CLUSTER_ID",
                   help="remove the PR from this one cluster")
    g.add_argument("--all", action="store_true",
                   help="remove the PR from every cluster it belongs to")
    p.add_argument("--store", default=None, help="store root (testing hook)")
    args = p.parse_args(argv)

    store = Store(args.store) if args.store else Store()

    pr = store.load_pr(args.pr)
    if pr is None:
        print(f"uncluster: PR #{args.pr} is not in the store", file=sys.stderr)
        return 2
    memberships = list(pr.cluster_ids)
    targets = memberships if args.all else [args.cluster]

    if not args.all and args.cluster not in memberships:
        where = f"clusters {memberships}" if memberships else "no cluster"
        print(f"uncluster: PR #{args.pr} is not in cluster {args.cluster} "
              f"(it is in {where})", file=sys.stderr)
        return 2
    if args.all and not memberships:
        print(f"uncluster: PR #{args.pr} is already standalone (in no cluster)",
              file=sys.stderr)
        return 2

    removed = []
    for cid in targets:
        if store.load_cluster(cid) is None:
            print(f"uncluster: cluster {cid} is not in the store", file=sys.stderr)
            return 2
        store.edit_cluster(cid).remove_member(args.pr)
        removed.append(cid)

    now = storekit.now()
    store.append_run({"phase": "cluster:manual-uncluster", "started": now,
                      "finished": now, "actor": "cockpit-agent",
                      "stats": {"pr": args.pr, "removed_from": removed}})

    still = store.load_pr(args.pr).cluster_ids
    here = " ".join(str(c) for c in removed)
    print(f"detached PR #{args.pr} from cluster(s) {here}; "
          f"now in {still or 'no cluster (standalone)'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
