# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# SQLite databases (store.db, store.db-wal, store.db-shm)
*.db
*.db-wal
*.db-shm

# store_edit pre-image snapshots
pipeline/store/backups/

# Issue-cluster briefings — local working notes written by /diagnose-issue-cluster
docs/issue-briefings/

# Triage verdicts — local run artifacts written by /diagnose-issue-cluster and the
# ANALYZE batch paths; the directory itself stays, via its .gitkeep
issue_triage/verdicts/*.json

# Generated store projections — regenerated by pipeline/views.py /
# issue_triage/issue_views.py on demand
STATUS.md
pipeline/STATUS.md
ISSUE-STATUS.md
issue_triage/SUMMARY.md

# Claude Code worktrees
.claude/worktrees/

# JetBrains IDE (per-machine project config)
.idea/

# macOS
.DS_Store

# GitHub CLI auth (never commit credentials, including from legacy/local
# GH_CONFIG_DIR setups)
.gh-config/hosts.yml

# gh API response cache (per-PR + per-file)
.gh-cache/


# Superpowers brainstorm companion (local only)
.superpowers/

# Single local environment file (holds the DB secret)
.env

# Local repository-policy profile (deployment data, never committed;
# profile.example.json documents the shape)
/profile.json

# Per-checkout editor launch config: setup.sh generates it from
# .claude/launch.example.json with this checkout's ports.
/.claude/launch.json
